# SerpApi API Key (Required for live search signals)
# Get a free key with 100 searches/month at https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# Optional Groq API key for grounded job-posting field extraction
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude API Key (Optional: for enhanced posting text extraction)
# If omitted or left empty, a robust built-in regex extractor is used automatically
ANTHROPIC_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# SQLite Cache Settings
CACHE_DB_PATH=app_cache.db
CACHE_TTL_HOURS=24
